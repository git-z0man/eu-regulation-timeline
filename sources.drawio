<mxfile><diagram name="Timeline"><mxGraphModel grid="0" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Where the information comes from" style="text;html=1;fontSize=18;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20.0" y="8.0" width="1200.0" height="28.0" as="geometry"/></mxCell><mxCell id="c3" value="Sources (left) are read by the tools (middle), which write the files of the repository (right); the analysis and the public site are built from them. The routine runs the tools on weekdays at 05:15 UTC and opens a pull request; it is merged once the checks pass." style="text;html=1;fontSize=11;fontColor=#555555;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="20.0" y="36.0" width="1500.0" height="18.0" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=0;arcSize=50;fillColor=#e8f0fb;strokeColor=#2f5a9e;" vertex="1" parent="1"><mxGeometry x="20.0" y="80.0" width="420.0" height="46.0" as="geometry"/></mxCell><mxCell id="c5" value="Cellar / EUR-Lex" style="text;html=1;fontSize=12;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="24.0" y="82.0" width="412.0" height="20.0" as="geometry"/></mxCell><mxCell id="c6" value="Publications Office: acts, proposals, corrigenda (SPARQL, XHTML), procedure files" style="text;html=1;fontSize=9.5;fontColor=#444444;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="24.0" y="101.0" width="412.0" height="22.0" as="geometry"/></mxCell><mxCell id="c7" value="" style="rounded=0;arcSize=50;fillColor=#e8f0fb;strokeColor=#2f5a9e;" vertex="1" parent="1"><mxGeometry x="20.0" y="136.0" width="420.0" height="46.0" as="geometry"/></mxCell><mxCell id="c8" value="European Parliament" style="text;html=1;fontSize=12;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;fontStyle=1;" vertex="1" paren