<mxfile><diagram name="Timeline"><mxGraphModel grid="0" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Legislative procedure – NLF Decision – Decision 768/2008" style="text;html=1;fontSize=18;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20.0" y="8.0" width="1600.0" height="28.0" as="geometry"/></mxCell><mxCell id="c3" value="Procedure 2007/0030(COD). Route: agreement at first reading: the Council approved the EP position. Upper part: the ordinary legislative procedure (Art. 294 TFEU); lower part: the act&#x27;s procedure over time. Every event cites its source (see nlf-decision.html)." style="text;html=1;fontSize=11;fontColor=#555555;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="20.0" y="36.0" width="1700.0" height="18.0" as="geometry"/></mxCell><mxCell id="c4" value="Ordinary legislative procedure (Art. 294 TFEU)" style="text;html=1;fontSize=13;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20.0" y="68.0" width="900.0" height="20.0" as="geometry"/></mxCell><mxCell id="c5" value="" style="rounded=0;arcSize=50;fillColor=#dce6f6;strokeColor=#2f5a9e;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1010.0" y="94.0" width="22.0" height="11.0" as="geometry"/></mxCell><mxCell id="c6" value="route taken / step done" style="text;html=1;fontSize=9;fontColor=#444444;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1037.0" y="92.0" width="150.0" height="15.0" as="geometry"/></mxCell><mxCell id="c7" value="" style="rounded=0;arcSize=50;fillColor=#fff3c4;strokeColor=#b07520;dashed=1;dashPattern=6 3;strokeWidth=2;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1010.0" y="114.0" width="22.0" height="11.0" as="geometry"/></mxCell><mxCell id="c8" value="step in progress" style="text;html=1;fontSize=9;fontColor=#444444;align=left