<mxfile><diagram name="Timeline"><mxGraphModel grid="0" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Legislative procedure – EU Space Act – COM(2025) 335 (proposal)" style="text;html=1;fontSize=18;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20.0" y="8.0" width="1600.0" height="28.0" as="geometry"/></mxCell><mxCell id="c3" value="Procedure 2025/0335(COD). Upper part: the ordinary legislative procedure (Art. 294 TFEU); steps done (blue) and in progress (orange) as of 01 Oct 2026. Lower part: the act&#x27;s procedure over time. Every event cites its source (see space-act.html)." style="text;html=1;fontSize=11;fontColor=#555555;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="20.0" y="36.0" width="1700.0" height="18.0" as="geometry"/></mxCell><mxCell id="c4" value="Ordinary legislative procedure (Art. 294 TFEU)" style="text;html=1;fontSize=13;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20.0" y="68.0" width="900.0" height="20.0" as="geometry"/></mxCell><mxCell id="c5" value="" style="rounded=0;arcSize=50;fillColor=#dce6f6;strokeColor=#2f5a9e;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="20.0" y="150.0" width="190.0" height="58.0" as="geometry"/></mxCell><mxCell id="c6" value="Commission proposal" style="text;html=1;fontSize=11;fontColor=#1f2d3d;align=center;verticalAlign=middle;spacingLeft=4;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20.0" y="154.0" width="190.0" height="20.0" as="geometry"/></mxCell><mxCell id="c7" value="Art. 294(2)" style="text;html=1;fontSize=9;fontColor=#555555;align=center;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="20.0" y="188.0" width="190.0" height="16.0" as="geometry"/></mxCell><mxCell id="c8" value="25 Jun 2025" style="text;html=1;fontSize=9;fontColor=#2f5a9e;align=cente