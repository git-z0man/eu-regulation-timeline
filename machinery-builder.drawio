s; safety, recalls, online sales." style="text;html=1;fontSize=10;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=4;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1480.0" y="616.0" width="320.0" height="42.0" as="geometry"/></mxCell><mxCell id="c119" value="" style="line;html=1;strokeWidth=1;strokeColor=#eceef0;" vertex="1" parent="1"><mxGeometry x="20.0" y="658.0" width="1780.0" height="1.0" as="geometry"/></mxCell><UserObject label="" id="c120" tooltip="low: low relevance for this profile"><mxCell style="rounded=0;arcSize=50;fillColor=#ffffff;strokeColor=#8a9096;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20.8" y="677.8" width="8.5" height="8.5" as="geometry"/></mxCell></UserObject><UserObject label="IMERA – Reg. 2024/2747" id="c121" link="http://data.europa.eu/eli/reg/2024/2747/oj"><mxCell style="text;html=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="32.0" y="658.0" width="238.0" height="48.0" as="geometry"/></mxCell></UserObject><UserObject label="" id="c122" link="http://data.europa.eu/eli/reg/2024/2747/oj"><mxCell style="rounded=0;arcSize=50;fillColor=#f1f2f3;strokeColor=#8a9096;" vertex="1" parent="1"><mxGeometry x="434.5" y="675.0" width="254.6" height="14.0" as="geometry"/></mxCell></UserObject><UserObject label="" id="c123" link="http://data.europa.eu/eli/reg/2024/2747/oj"><mxCell style="rounded=0;arcSize=50;fillColor=#cdd1d4;strokeColor=#8a9096;" vertex="1" parent="1"><mxGeometry x="689.1" y="675.0" width="781.0" height="14.0" as="geometry"/></mxCell></UserObject><UserObject label="" id="c124" link="http://data.europa.eu/eli/reg/2024/2747/oj" tooltip="Applies: 29 May 2026 (Art. 48)"><mxCell style="rhombus;fillColor=#14181c;strokeColor=#ffffff;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="683.1" y="676.0" width="12.0" height="12.0" as="geometry"/></mxCell></UserObject><UserObject label="Applies" id="c125" link="http://data.europa.eu/eli/reg/2024/2747/oj"><mxCell style="text;html=1;fontSize=9;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="681.1" y="661.0" width="43.0" height="13.0" as="geometry"/></mxCell></UserObject><mxCell id="c126" value="Only in an internal market emergency; priority orders, fast-track conformity assessment." style="text;html=1;fontSize=10;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=4;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1480.0" y="664.0" width="320.0" height="42.0" as="geometry"/></mxCell><mxCell id="c127" value="" style="line;html=1;strokeWidth=1;strokeColor=#eceef0;" vertex="1" parent="1"><mxGeometry x="20.0" y="706.0" width="1780.0" height="1.0" as="geometry"/></mxCell><UserObject label="" id="c128" tooltip="operate: applies"><mxCell style="rounded=0;arcSize=50;fillColor=#6e9195;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="20.0" y="725.0" width="10.0" height="10.0" as="geometry"/></mxCell></UserObject><UserObject label="MSR – Reg. 2019/1020" id="c129" link="http://data.europa.eu/eli/reg/2019/1020/oj"><mxCell style="text;html=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="32.0" y="706.0" width="238.0" height="48.0" as="geometry"/></mxCell></UserObject><UserObject label="" id="c130" link="http://data.europa.eu/eli/reg/2019/1020/oj"><mxCell style="rounded=0;arcSize=50;fillColor=#6e9195;strokeColor=#4f6f73;" vertex="1" parent="1"><mxGeometry x="280.0" y="723.0" width="1190.1" height="14.0" as="geometry"/></mxCell></UserObject><mxCell id="c131" value="Market surveillance of machinery and other CE-marked products. A machine under the Machinery Directive (listed in Art. 4(5) MSR) may be placed on the market only with an economic operator established in the Union who answers to the authorities (Art. 4 MSR), also for online sales. To be merged into the European Product Act." style="text;html=1;fontSize=10;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=4;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1480.0" y="712.0" width="320.0" height="85.0" as="geometry"/></mxCell><mxCell id="c132" value="" style="line;html=1;strokeWidth=1;strokeColor=#eceef0;" vertex="1" parent="1"><mxGeometry x="20.0" y="797.0" width="1780.0" height="1.0" as="geometry"/></mxCell><UserObject label="" id="c133" tooltip="monitor: proposal or legislative procedure"><mxCell style="rounded=0;arcSize=50;fillColor=#a7b7ba;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="20.0" y="816.0" width="10.0" height="10.0" as="geometry"/></mxCell></UserObject><UserObject label="EPA (NLF revision)" id="c134" link="https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:52025IP0242"><mxCell style="text;html=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="32.0" y="797.0" width="238.0" height="48.0" as="geometry"/></mxCell></UserObject><UserObject label="" id="c135" link="https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:52025IP0242" tooltip="expected"><mxCell style="rounded=0;arcSize=50;fillColor=#ecf0f1;strokeColor=#7a8b8e;dashed=1;dashPattern=6 3;strokeWidth=2;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="789.7" y="814.0" width="340.2" height="14.0" as="geometry"/></mxCell></UserObject><UserObject label="" id="c136" link="https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:52025IP0242" tooltip="EP resolution: 21 Oct 2025"><mxCell style="rhombus;fillColor=#ffffff;strokeColor=#222222;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="580.7" y="815.0" width="12.0" height="12.0" as="geometry"/></mxCell></UserObject><UserObject label="EP resolution" id="c137" link="https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:52025IP0242"><mxCell style="text;html=1;fontSize=9;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="578.7" y="800.0" width="73.0" height="13.0" as="geometry"/></mxCell></UserObject><UserObject label="" id="c138" link="https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:52025IP0242" tooltip="Proposal expected by end 2026 (postponed): 31 Dec 2026"><mxCell style="rhombus;fillColor=#ffffff;strokeColor=#222222;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="783.7" y="815.0" width="12.0" height="12.0" as="geometry"/></mxCell></UserObject><UserObject label="Proposal expected by end 2026 (postponed)" id="c139" link="https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:52025IP0242"><mxCell style="text;html=1;fontSize=9;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="781.7" y="832.0" width="213.0" height="13.0" as="geometry"/></mxCell></UserObject><mxCell id="c140" value="New horizontal product framework replacing the NLF acts; CE marking, conformity assessment, digital product information." style="text;html=1;fontSize=10;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=4;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1480.0" y="803.0" width="320.0" height="42.0" as="geometry"/></mxCell><mxCell id="c141" value="" style="line;html=1;strokeWidth=1;strokeColor=#eceef0;" vertex="1" parent="1"><mxGeometry x="20.0" y="845.0" width="1780.0" height="1.0" as="geometry"/></mxCell><UserObject label="" id="c142" tooltip="monitor: proposal or legislative procedure"><mxCell style="rounded=0;arcSize=50;fillColor=#a7b7ba;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="20.0" y="864.0" width="10.0" height="10.0" as="geometry"/></mxCell></UserObject><UserObject label="NSR (revision of Reg. 1025/2012)" id="c143" link="https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:52026PC0780"><mxCell style="text;html=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="32.0" y="845.0" width="238.0" height="48.0" as="geometry"/></mxCell></UserObject><UserObject label="" id="c144" link="https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:52026PC0780"><mxCell style="rounded=0;arcSize=50;fillColor=#ecf0f1;strokeColor=#7a8b8e;dashed=1;dashPattern=6 3;strokeWidth=2;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="749.6" y="862.0" width="294.6" height="14.0" as="geometry"/></mxCell></UserObject><UserObject label="" id="c145" link="http://publications.europa.eu/resource/cellar/dd0d07a2-c1c6-11f1-988f-01aa75ed71a1.0001.03/DOC_1" tooltip="COM(2026) 780: 06 Oct 2026"><mxCell style="rhombus;fillColor=#ffffff;strokeColor=#222222;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="743.6" y="863.0" width="12.0" height="12.0" as="geometry"/></mxCell></UserObject><UserObject label="COM(2026) 780" id="c146" link="http://publications.europa.eu/resource/cellar/dd0d07a2-c1c6-11f1-988f-01aa75ed71a1.0001.03/DOC_1"><mxCell style="text;html=1;fontSize=9;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="761.5" y="848.0" width="73.0" height="13.0" as="geometry"/></mxCell></UserObject><mxCell id="c147" value="Proposed 6 Oct 2026 (COM(2026) 780), replaces Reg. 1025/2012 six months after entry into force (Art. 43; entry into force expected in 2028), without transitional rules. Free online access to referenced standards (Art. 5); interim deliverables, designated standards development organisations and common specifications when the ESOs are late (Arts. 2(7), 29, 32). M/606 (CRA) expires before, M/605 phase 2 (machinery, due 2034) runs across the switch; Art. 20 MR and Art. 27 CRA still name only harmonised standards." style="text;html=1;fontSize=10;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=4;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1480.0" y="851.0" width="320.0" height="122.0" as="geometry"/></mxCell><mxCell id="c148" value="" style="line;html=1;strokeWidth=1;strokeColor=#eceef0;" vertex="1" parent="1"><mxGeometry x="20.0" y="973.0" width="1780.0" height="1.0" as="geometry"/></mxCell><UserObject label="" id="c149" tooltip="monitor: proposal or legislative procedure"><mxCell style="rounded=0;arcSize=50;fillColor=#a7b7ba;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="20.0" y="992.0" width="10.0" height="10.0" as="geometry"/></mxCell></UserObject><UserObject label="Digitalisation &amp; common specs" id="c150" link="https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:52025PC0504"><mxCell style="text;html=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="32.0" y="973.0" width="238.0" height="48.0" as="geometry"/></mxCell></UserObject><UserObject label="" id="c151" link="https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:52025PC0504"><mxCell style="rounded=0;arcSize=50;fillColor=#ecf0f1;strokeColor=#7a8b8e;dashed=1;dashPattern=6 3;strokeWidth=2;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="515.5" y="990.0" width="358.4" height="14.0" as="geometry"/></mxCell></UserObject><UserObject label="" id="c152" link="https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:52025PC0504" tooltip="COM(2025) 503/504: 21 May 2025"><mxCell style="rhombus;fillColor=#ffffff;strokeColor=#222222;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="509.5" y="991.0" width="12.0" height="12.0" as="geometry"/></mxCell></UserObject><UserObject label="COM(2025) 503/504" id="c153" link="https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:52025PC0504"><mxCell style="text;html=1;fontSize=9;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="507.5" y="976.0" width="93.0" height="13.0" as="geometry"/></mxCell></UserObject><UserObject label="" id="c154" link="https://data.consilium.europa.eu/doc/document/ST-13018-2025-INIT/en/pdf" tooltip="Council mandate: 24 Sep 2025"><mxCell style="rhombus;fillColor=#ffffff;strokeColor=#222222;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="568.2" y="991.0" width="12.0" height="12.0" as="geometry"/></mxCell></UserObject><UserObject label="Council mandate" id="c155" link="https://data.consilium.europa.eu/doc/document/ST-13018-2025-INIT/en/pdf"><mxCell style="text;html=1;fontSize=9;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="566.2" y="1008.0" width="83.0" height="13.0" as="geometry"/></mxCell></UserObject><UserObject label="" id="c156" link="https://data.europarl.europa.eu/distribution/reds_iPlRp/A-10-2026-0024/A-10-2026-0024_en.docx" tooltip="EP mandate: 11 Mar 2026"><mxCell style="rhombus;fillColor=#ffffff;strokeColor=#222222;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="646.3" y="991.0" width="12.0" height="12.0" as="geometry"/></mxCell></UserObject><UserObject label="EP mandate" id="c157" link="https://data.europarl.europa.eu/distribution/reds_iPlRp/A-10-2026-0024/A-10-2026-0024_en.docx"><mxCell style="text;html=1;fontSize=9;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="644.3" y="976.0" width="58.0" height="13.0" as="geometry"/></mxCell></UserObject><UserObject label="" id="c158" link="https://data.consilium.europa.eu/doc/document/ST-10482-2026-REV-2/en/pdf" tooltip="Agreement: 09 Jun 2026"><mxCell style="rhombus;fillColor=#ffffff;strokeColor=#222222;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="688.2" y="991.0" width="12.0" height="12.0" as="geometry"/></mxCell></UserObject><UserObject label="Agreement" id="c159" link="https://data.consilium.europa.eu/doc/document/ST-10482-2026-REV-2/en/pdf"><mxCell style="text;html=1;fontSize=9;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="686.2" y="1008.0" width="53.0" height="13.0" as="geometry"/></mxCell></UserObject><mxCell id="c160" value="Agreed 9 Jun 2026, applies 30 months after entry into force. Digital declaration of conformity and instructions; common specifications; amends the Machinery Regulation." style="text;html=1;fontSize=10;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=4;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1480.0" y="979.0" width="320.0" height="48.0" as="geometry"/></mxCell><mxCell id="c161" value="" style="line;html=1;strokeWidth=1;strokeColor=#eceef0;" vertex="1" parent="1"><mxGeometry x="20.0" y="1027.0" width="1780.0" height="1.0" as="geometry"/></mxCell><mxCell id="c162" value="Industrial policy" style="text;html=1;fontSize=12;fontColor=#14181c;align=left;verticalAlign=middle;spacingLeft=4;fontStyle=1;fillColor=#eef2f2;" vertex="1" parent="1"><mxGeometry x="20.0" y="1031.0" width="1780.0" height="24.0" as="geometry"/></mxCell><UserObject label="" id="c163" tooltip="low: low relevance for this profile"><mxCell style="rounded=0;arcSize=50;fillColor=#ffffff;strokeColor=#8a9096;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20.8" y="1076.8" width="8.5" height="8.5" as="geometry"/></mxCell></UserObject><UserObject label="Net Zero Industry Act" id="c164" link="http://data.europa.eu/eli/reg/2024/1735/oj"><mxCell style="text;html=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="32.0" y="1057.0" width="238.0" height="48.0" as="geometry"/></mxCell></UserObject><UserObject label="" id="c165" link="http://data.europa.eu/eli/reg/2024/1735/oj"><mxCell style="rounded=0;arcSize=50;fillColor=#cdd1d4;strokeColor=#8a9096;" vertex="1" parent="1"><mxGeometry x="363.8" y="1074.0" width="1106.3" height="14.0" as="geometry"/></mxCell></UserObject><UserObject label="" id="c166" link="http://data.europa.eu/eli/reg/2024/1735/oj" tooltip="Auctions: resilience and cyber criteria: 30 Dec 2025 (Art. 49)"><mxCell style="rhombus;fillColor=#ffffff;strokeColor=#222222;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="613.3" y="1075.0" width="12.0" height="12.0" as="geometry"/></mxCell></UserObject><UserObject label="Auctions: resilience and cyber criteria" id="c167" link="http://data.europa.eu/eli/reg/2024/1735/oj"><mxCell style="text;html=1;fontSize=9;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="414.3" y="1060.0" width="203.0" height="13.0" as="geometry"/></mxCell></UserObject><UserObject label="" id="c168" link="http://data.europa.eu/eli/reg/2024/1735/oj" tooltip="Procurement rules for all contracts: 01 Jul 2026 (Art. 49)"><mxCell style="rhombus;fillColor=#ffffff;strokeColor=#222222;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="698.5" y="1075.0" width="12.0" height="12.0" as="geometry"/></mxCell></UserObject><UserObject label="Procurement rules for all contracts" id="c169" link="http://data.europa.eu/eli/reg/2024/1735/oj"><mxCell style="text;html=1;fontSize=9;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="519.5" y="1092.0" width="183.0" height="13.0" as="geometry"/></mxCell></UserObject><mxCell id="c170" value="Rules for public buyers and renewable energy auctions (resilience, cyber security pre-qualification); relevant when supplying control systems to net-zero projects." style="text;html=1;fontSize=10;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=4;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1480.0" y="1063.0" width="320.0" height="48.0" as="geometry"/></mxCell><mxCell id="c171" value="" style="line;html=1;strokeWidth=1;strokeColor=#eceef0;" vertex="1" parent="1"><mxGeometry x="20.0" y="1111.0" width="1780.0" height="1.0" as="geometry"/></mxCell><UserObject label="" id="c172" tooltip="monitor: proposal or legislative procedure"><mxCell style="rounded=0;arcSize=50;fillColor=#a7b7ba;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="20.0" y="1130.0" width="10.0" height="10.0" as="geometry"/></mxCell></UserObject><UserObject label="Public Procurement Act" id="c173" link="https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:52026PC0590"><mxCell style="text;html=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="32.0" y="1111.0" width="238.0" height="48.0" as="geometry"/></mxCell></UserObject><UserObject label="" id="c174" link="https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:52026PC0590"><mxCell style="rounded=0;arcSize=50;fillColor=#ecf0f1;strokeColor=#7a8b8e;dashed=1;dashPattern=6 3;strokeWidth=2;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="737.1" y="1128.0" width="392.8" height="14.0" as="geometry"/></mxCell></UserObject><UserObject label="" id="c175" link="https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:52026PC0590" tooltip="Proposal: 09 Sep 2026"><mxCell style="rhombus;fillColor=#ffffff;strokeColor=#222222;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="731.1" y="1129.0" width="12.0" height="12.0" as="geometry"/></mxCell></UserObject><UserObject label="Proposal" id="c176" link="https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:52026PC0590"><mxCell style="text;html=1;fontSize=9;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="687.1" y="1114.0" width="48.0" height="13.0" as="geometry"/></mxCell></UserObject><mxCell id="c177" value="Public buyers of machinery; EU preference and cyber criteria in tenders; excludes high-risk suppliers (CSA2); amends the CRA." style="text;html=1;fontSize=10;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=4;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1480.0" y="1117.0" width="320.0" height="48.0" as="geometry"/></mxCell><mxCell id="c178" value="" style="line;html=1;strokeWidth=1;strokeColor=#eceef0;" vertex="1" parent="1"><mxGeometry x="20.0" y="1165.0" width="1780.0" height="1.0" as="geometry"/></mxCell><UserObject label="" id="c179" tooltip="monitor: proposal or legislative procedure"><mxCell style="rounded=0;arcSize=50;fillColor=#a7b7ba;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="20.0" y="1184.0" width="10.0" height="10.0" as="geometry"/></mxCell></UserObject><UserObject label="Industrial Accelerator Act" id="c180" link="https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:52026PC0100"><mxCell style="text;html=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="32.0" y="1165.0" width="238.0" height="48.0" as="geometry"/></mxCell></UserObject><UserObject label="" id="c181" link="https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:52026PC0100"><mxCell style="rounded=0;arcSize=50;fillColor=#ecf0f1;strokeColor=#7a8b8e;dashed=1;dashPattern=6 3;strokeWidth=2;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="649.1" y="1182.0" width="395.2" height="14.0" as="geometry"/></mxCell></UserObject><UserObject label="" id="c182" link="https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:52026PC0100" tooltip="Proposal: 04 Mar 2026"><mxCell style="rhombus;fillColor=#ffffff;strokeColor=#222222;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="643.1" y="1183.0" width="12.0" height="12.0" as="geometry"/></mxCell></UserObject><UserObject label="Proposal" id="c183" link="https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:52026PC0100"><mxCell style="text;html=1;fontSize=9;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="641.1" y="1168.0" width="48.0" height="13.0" as="geometry"/></mxCell></UserObject><mxCell id="c184" value="&quot;Made in Europe&quot; criteria for public support; amends the NZIA: no high-risk suppliers (CSA2) in control and SCADA systems of energy auctions." style="text;html=1;fontSize=10;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=4;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1480.0" y="1171.0" width="320.0" height="48.0" as="geometry"/></mxCell><mxCell id="c185" value="" style="line;html=1;strokeWidth=1;strokeColor=#eceef0;" vertex="1" parent="1"><mxGeometry x="20.0" y="1219.0" width="1780.0" height="1.0" as="geometry"/></mxCell><mxCell id="c186" value="" style="line;html=1;strokeWidth=2;strokeColor=#0f5a63;direction=south;" vertex="1" parent="1"><mxGeometry x="757.5" y="88.0" width="1.0" height="1131.0" as="geometry"/></mxCell><mxCell id="c187" value="Rating" style="text;html=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20.0" y="1241.0" width="96.0" height="18.0" as="geometry"/></mxCell><mxCell id="c188" value="" style="rounded=0;arcSize=50;fillColor=#0b4f57;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="116.0" y="1244.0" width="12.0" height="12.0" as="geometry"/></mxCell><mxCell id="c189" value="Act now: obligations within 15 months" style="text;html=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="130.0" y="1241.0" width="252.8" height="18.0" as="geometry"/></mxCell><mxCell id="c190" value="" style="rounded=0;arcSize=50;fillColor=#3d7f86;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="386.8" y="1244.0" width="12.0" height="12.0" as="geometry"/></mxCell><mxCell id="c191" value="Prepare: obligations in 15–36 months" style="text;html=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="400.8" y="1241.0" width="252.8" height="18.0" as="geometry"/></mxCell><mxCell id="c192" value="" style="rounded=0;arcSize=50;fillColor=#6e9195;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="657.6" y="1244.0" width="12.0" height="12.0" as="geometry"/></mxCell><mxCell id="c193" value="In operation: nothing new soon" style="text;html=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="671.6" y="1241.0" width="252.8" height="18.0" as="geometry"/></mxCell><mxCell id="c194" value="" style="rounded=0;arcSize=50;fillColor=#a7b7ba;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="928.4" y="1244.0" width="12.0" height="