eWidth=1.5;" vertex="1" parent="1"><mxGeometry x="688.2" y="679.0" width="12.0" height="12.0" as="geometry"/></mxCell></UserObject><UserObject label="Agreement" id="c138" link="https://data.consilium.europa.eu/doc/document/ST-10482-2026-REV-2/en/pdf"><mxCell style="text;html=1;fontSize=8;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="698.2" y="694.0" width="130.0" height="13.0" as="geometry"/></mxCell></UserObject><mxCell id="c139" value="Agreed 9 Jun 2026, applies 30 months after entry into force. Digital declaration of conformity and instructions; common specifications; amends the Machinery Regulation." style="text;html=1;fontSize=10;fontColor=#333333;align=left;verticalAlign=middle;spacingLeft=4;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1480.0" y="664.0" width="320.0" height="42.0" as="geometry"/></mxCell><mxCell id="c140" value="" style="line;html=1;strokeWidth=1;strokeColor=#eceef0;" vertex="1" parent="1"><mxGeometry x="20.0" y="706.0" width="1780.0" height="1.0" as="geometry"/></mxCell><mxCell id="c141" value="Industrial policy" style="text;html=1;fontSize=12;fontColor=#ffffff;align=left;verticalAlign=middle;spacingLeft=4;fontStyle=1;fillColor=#44505c;" vertex="1" parent="1"><mxGeometry x="20.0" y="712.0" width="1780.0" height="30.0" as="geometry"/></mxCell><UserObject label="" id="c142" tooltip="monitor: proposal or legislative procedure"><mxCell style="rounded=1;arcSize=50;fillColor=#4a78c2;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="20.0" y="762.0" width="10.0" height="14.0" as="geometry"/></mxCell></UserObject><UserObject label="Public Procurement Act" id="c143" link="https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:52026PC0590"><mxCell style="text;html=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="32.0" y="748.0" width="238.0" height="42.0" as="geometry"/></mxCell></UserObject><UserObject label="" id